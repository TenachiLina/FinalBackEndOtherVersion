# MongoDB connection string
MONGODB_URI=

# Random string, at least 64 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit the real value. Changing it signs everybody out.
JWT_SECRET=change-me

# ── Sessions and tokens ──────────────────────────────────────────────────
# Access token lifetime: renewed automatically by the app (rotation).
ACCESS_TOKEN_TTL=15m
# A session ends after this long without activity...
SESSION_IDLE_TIMEOUT=4h
# ...and in any case this long after sign-in.
SESSION_MAX_AGE=12h
# Requests per minute per IP address (login: 10, refresh: 30)
RATE_LIMIT_PER_MINUTE=600

# ── HTTPS ────────────────────────────────────────────────────────────────
# Local HTTPS: paths to a certificate and its key (see README "HTTPS").
# Leave empty on Render: Render's proxy handles HTTPS.
SSL_CERT_PATH=
SSL_KEY_PATH=
# Refuse plain HTTP. Defaults to true in production (NODE_ENV=production or Render).
FORCE_HTTPS=
# Number of proxies in front of the app (Render: 1, the default in production).
TRUST_PROXY=

# Frontend URLs allowed to call the API (comma-separated, https:// in production)
FRONTEND_URL=

# Only read by `npm run migrate:companies`; devices are now set per company in the app.
ZKTECO_DEVICE_SERIAL=
